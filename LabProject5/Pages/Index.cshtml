@page
@model LabProject5.Pages.IndexModel
@{
    ViewData["Title"] = "Class Manager";
}

<div class="container mt-4">

    @if (HttpContext.Session.GetString("username") != null)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center">
            <div>
                <strong>Logged in as:</strong> @HttpContext.Session.GetString("username") <br />
                <strong>Token:</strong> @HttpContext.Session.GetString("token") <br />
                <strong>Session ID:</strong> @HttpContext.Session.GetString("session_id")
            </div>
            <form method="post" asp-page-handler="Logout" class="ms-3 mb-0">
                <button type="submit" class="btn btn-danger btn-sm">Logout</button>
            </form>
        </div>
    }

    <div class="card mb-4" style="background-color: #b3b2bc;">
        <div class="card-body">
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="SearchKeyword" value="@Model.SearchKeyword" class="form-control"
                        placeholder="🔍 Search by class name or description..." />
                    <button class="btn btn-primary" type="submit">Filter</button>
                </div>
            </form>

            <form method="post" asp-page-handler="@(Model.IsEditMode ? "Edit" : "Add")" class="row g-3 mb-3">
                <input type="hidden" asp-for="ClassInput.Id" />
                <div class="col-md-4">
                    <input asp-for="ClassInput.Name" class="form-control" placeholder="Class Name" />
                    <span asp-validation-for="ClassInput.Name" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <input asp-for="ClassInput.PersonCount" class="form-control" placeholder="Person Count" />
                    <span asp-validation-for="ClassInput.PersonCount" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <input asp-for="ClassInput.Description" class="form-control" placeholder="Description" />
                    <span asp-validation-for="ClassInput.Description" class="text-danger"></span>
                </div>
                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary">
                        @(Model.IsEditMode ? "Update Class" : "Add Class")
                    </button>
                </div>
            </form>

            <form method="post" asp-page-handler="ExportJson" id="exportForm">
                <input type="hidden" id="selectedColumns" name="SelectedColumns" />
                <button type="submit" class="btn btn-success mb-2">Export to JSON</button>
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <h4>Class List</h4>
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th class="selectable-col" data-col="Name" style="cursor:pointer;">Class Name</th>
                        <th class="selectable-col" data-col="PersonCount" style="cursor:pointer;">Person Count</th>
                        <th class="selectable-col" data-col="Description" style="cursor:pointer;">Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredClassList)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.PersonCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="EditSelect" class="btn btn-sm btn-warning" title="Edit">
                                        <img src="~/images/pencil.svg" alt="Edit" width="16" height="16" />
                                    </button>
                                </form>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-sm btn-danger" title="Delete">
                                        <img src="~/images/trash.svg" alt="Delete" width="16" height="16" />
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <nav>
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="?SearchKeyword=@Model.SearchKeyword&PageNumber=@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let selectedCols = [];
        document.querySelectorAll(".selectable-col").forEach(th => {
            th.addEventListener("click", function () {
                const col = this.getAttribute("data-col");
                if (selectedCols.includes(col)) {
                    selectedCols = selectedCols.filter(x => x !== col);
                    this.style.backgroundColor = "";
                    this.style.color = "";
                } else {
                    selectedCols.push(col);
                    this.style.backgroundColor = "#32cd32";
                    this.style.color = "white";
                }
            });
        });
        document.getElementById("exportForm").addEventListener("submit", function () {
            document.getElementById("selectedColumns").value = selectedCols.join(",");
        });
    </script>
}
