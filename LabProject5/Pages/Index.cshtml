@page
@model LabProject5.Pages.IndexModel
@{
    ViewData["Title"] = "Class Manager";
}

<div class="container mt-4">


    <div class="card mb-4" style="background-color: #b3b2bc;">
        <div class="card-body">

            <form method="get">
                <div class="input-group mb-3">
                    <input type="text" name="SearchKeyword" value="@Model.SearchKeyword" class="form-control"
                        placeholder="🔍 Search by class name or description..." />
                    <button class="btn btn-primary" type="submit">Filter</button>
                </div>
            </form>


            <hr />


            <form method="post" asp-page-handler="@(Model.IsEditMode ? "Edit" : "Add")" class="row g-3 mt-2">
                <input type="hidden" asp-for="ClassInput.Id" />

                <div class="col-md-4">
                    <input asp-for="ClassInput.ClassName" class="form-control" placeholder="Class Name" />
                    <span asp-validation-for="ClassInput.ClassName" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <input asp-for="ClassInput.StudentCount" class="form-control" placeholder="Student Count" />
                    <span asp-validation-for="ClassInput.StudentCount" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <input asp-for="ClassInput.Description" class="form-control" placeholder="Description" />
                    <span asp-validation-for="ClassInput.Description" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        @(Model.IsEditMode ? "Update Class" : "Add Class")
                    </button>
                </div>
            </form>
        </div>
    </div>


    <div class="row">
        <div class="col-12">
            <h4>Class List</h4>
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredClassList)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="EditSelect" class="btn btn-sm btn-warning"
                                        title="Edit">
                                        <img src="~/images/pencil.svg" alt="Edit" width="16" height="16" />
                                    </button>
                                </form>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-sm btn-danger"
                                        title="Delete">
                                        <img src="~/images/trash.svg" alt="Delete" width="16" height="16" />
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>


            <nav>
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="?SearchKeyword=@Model.SearchKeyword&PageNumber=@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
