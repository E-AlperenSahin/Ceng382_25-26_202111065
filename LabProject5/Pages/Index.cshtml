@page
@model LabProject5.Pages.IndexModel
@{
    ViewData["Title"] = "Class Manager";
}

<div class="container mt-4">
    <div class="row">
        <!-- Sol tarafta Form -->
        <div class="col-md-5">
            <h4>@(Model.IsEditMode ? "Edit Class" : "Add Class")</h4>
            <form method="post" asp-page-handler="@(Model.IsEditMode ? "Edit" : "Add")">
                <input type="hidden" asp-for="ClassInput.Id" />

                <div class="form-group mb-2">
                    <label asp-for="ClassInput.ClassName"></label>
                    <input asp-for="ClassInput.ClassName" class="form-control" />
                    <span asp-validation-for="ClassInput.ClassName" class="text-danger"></span>
                </div>

                <div class="form-group mb-2">
                    <label asp-for="ClassInput.StudentCount"></label>
                    <input asp-for="ClassInput.StudentCount" class="form-control" />
                    <span asp-validation-for="ClassInput.StudentCount" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ClassInput.Description"></label>
                    <textarea asp-for="ClassInput.Description" class="form-control"></textarea>
                    <span asp-validation-for="ClassInput.Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    @(Model.IsEditMode ? "Update" : "Add Class")
                </button>
            </form>
        </div>

        <!-- Sağ tarafta Tablo -->
        <div class="col-md-7">
            <h4>Class List</h4>
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in LabProject5.Pages.IndexModel.ClassList)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Edit"
                                        class="btn btn-sm btn-warning">Edit</button>
                                </form>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Delete"
                                        class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
